      <![CDATA[<meting-js  server="netease"  type="song"  id="歌曲UID"  mode="circulation"  autoplay="true"  mutex="false"  listmaxheight="340px"  preload="auto"  theme="#ad7a86"></meting-js><h1 id="个人开发的hexo插件-自定义弹窗插件"><a href="#个人开发的hexo插件-自定义弹窗插件" class="headerlink" title="个人开发的hexo插件|自定义弹窗插件"></a>个人开发的hexo插件|自定义弹窗插件</h1><h2 id="可用作赞助弹出"><a href="#可用作赞助弹出" class="headerlink" title="可用作赞助弹出"></a>可用作赞助弹出</h2><h2 id="快速入门"><a href="#快速入门" class="headerlink" title="快速入门"></a>快速入门</h2><h2 id="安装-npm-install-github-exwxsz-hexo-popup-counter-save"><a href="#安装-npm-install-github-exwxsz-hexo-popup-counter-save" class="headerlink" title="安装 npm install github:exwxsz/hexo-popup-counter --save"></a>安装 <code>npm install github:exwxsz/hexo-popup-counter --save</code></h2><h1 id="配置文件-config-yml新增以下内容"><a href="#配置文件-config-yml新增以下内容" class="headerlink" title="配置文件 _config.yml新增以下内容"></a>配置文件 _config.yml新增以下内容</h1><figure class="highlight yaml"><table><tr><td class="gutter"><pre><span class="line">1</span><br><span class="line">2</span><br><span class="line">3</span><br><span class="line">4</span><br><span class="line">5</span><br><span class="line">6</span><br><span class="line">7</span><br><span class="line">8</span><br><span class="line">9</span><br><span class="line">10</span><br><span class="line">11</span><br></pre></td><td class="code"><pre><span class="line"><span class="attr">popup_counter:</span></span><br><span class="line">  <span class="attr">enable:</span> <span class="literal">true</span></span><br><span class="line">  <span class="attr">title:</span> <span class="string">&quot;欢迎访问本站,急需大米救助谢谢喵&quot;</span></span><br><span class="line">  <span class="attr">content:</span> <span class="string">&quot;确认你是否满18&quot;</span></span><br><span class="line">  <span class="attr">images:</span></span><br><span class="line">    <span class="bullet">-</span> <span class="string">/images/banner.jpg</span>   <span class="comment"># 换成你自己的图片路径，也可以留空数组 []</span></span><br><span class="line">  <span class="attr">confirmText:</span> <span class="string">&quot;是&quot;</span></span><br><span class="line">  <span class="attr">cancelText:</span> <span class="string">&quot;不是&quot;</span></span><br><span class="line">  <span class="attr">width:</span> <span class="string">&quot;480px&quot;</span></span><br><span class="line">  <span class="attr">maxWidth:</span> <span class="string">&quot;600px&quot;</span></span><br><span class="line">  <span class="attr">showOnce:</span> <span class="literal">false</span> <span class="comment"># false=每次刷新都弹，方便测试</span></span><br></pre></td></tr></table></figure><h1 id="若有用请给我star谢谢喵"><a href="#若有用请给我star谢谢喵" class="headerlink" title="若有用请给我star谢谢喵"></a>若有用请给我star谢谢喵</h1><h1 id="没有米了喵，请好心人请我喝奶茶谢谢喵"><a href="#没有米了喵，请好心人请我喝奶茶谢谢喵" class="headerlink" title="没有米了喵，请好心人请我喝奶茶谢谢喵"></a>没有米了喵，请好心人请我喝奶茶谢谢喵</h1><p><img src="https://api.catcat.li/api/random" alt="随机图片"></p>]]>
